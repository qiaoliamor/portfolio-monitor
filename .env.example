# Production requires a libSQL database (not a Turso-engine database).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CACHE_PATH=data/cache.db
# Isolated sample history, never used automatically when cloud is unavailable.
DEMO_MODE=false
DEMO_HISTORY_PATH=data/demo-history.db
APP_ENV=development
SESSION_SECRET=
# Generate using: uv run portfolio hash-password
ADMIN_PASSWORD_HASH=
TWELVE_DATA_API_KEY=
TUSHARE_TOKEN=
FRED_API_KEY=
# Optional: manually enter the storage size shown in Turso console.
CLOUD_STORAGE_USED_MB=
CLOUD_STORAGE_LIMIT_MB=
